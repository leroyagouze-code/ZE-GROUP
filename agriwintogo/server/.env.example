# Copiez ce fichier en ".env" et changez les valeurs avant de démarrer le serveur.

# Port sur lequel le serveur écoute (Render/Railway le définissent automatiquement)
PORT=3000

# Identifiant et mot de passe pour vous connecter à /admin
ADMIN_USER=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Phrase secrète utilisée pour sécuriser les sessions de connexion.
# Mettez n'importe quelle longue phrase aléatoire, gardez-la privée.
SESSION_SECRET=changez-cette-phrase-secrete-aussi

NODE_ENV=production
